@startuml
left to right direction
skinparam componentStyle rectangle
actor "Mobile / Web clients" as Client
component "DNS / CDN / WAF" as Edge
component "L7 Load Balancer" as LB
component "API Gateway" as GW
component "Auth service" as Auth
component "Chat service" as Chat
component "Realtime Gateway\n(WebSocket)" as RT
component "Message service" as Msg
component "Media service" as Media
component "Notification service" as Notif
queue "Kafka" as Kafka
database "PostgreSQL\n(source of truth)" as PG
database "Redis\n(presence/cache)" as Redis
cloud "S3 / MinIO" as S3
database "OpenSearch\n(search index)" as OS
cloud "FCM / APNs" as Push
Client --> Edge : HTTPS / WSS
Edge --> LB
LB --> GW
GW --> Auth
GW --> Chat
GW --> Msg
GW --> RT
GW --> Media
Msg --> PG : transaction + outbox
Msg --> Kafka : via outbox relay
Chat --> PG
Auth --> PG
RT --> Redis
Media --> S3
Kafka --> RT : fan-out
Kafka --> Notif
Kafka --> OS : indexing
Notif --> Push
Kafka --> PG : delivery/read projections
@enduml
