@startuml
title Connect — схема компонентов
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #526579
skinparam packageStyle rectangle

actor "Мобильный / веб-клиент" as Client
cloud "Интернет" as Internet
component "CDN / WAF" as Edge
component "Балансировщик L7" as LB
component "API Gateway" as Gateway

package "Прикладные сервисы" {
  component "Авторизация" as Auth
  component "Чаты" as Chat
  component "WebSocket Gateway" as WS
  component "Сообщения" as Message
  component "Файлы" as Media
  component "Уведомления" as Notify
}

queue "Kafka\nсобытия" as Kafka

package "Хранение" {
  database "PostgreSQL\nосновные данные" as PG
  database "Redis\npresence и кэш" as Redis
  cloud "S3 / MinIO\nвложения" as S3
  database "OpenSearch\nпоиск" as Search
}

component "FCM / APNs" as Push
component "Мониторинг\nPrometheus • Grafana • Loki" as Monitor

Client --> Internet
Internet --> Edge
Edge --> LB
LB --> Gateway
Gateway --> Auth
Gateway --> Chat
Gateway --> WS
Gateway --> Message
Gateway --> Media
Auth --> PG
Chat --> PG
Message --> PG : запись + outbox
Message --> Kafka : публикация outbox
WS --> Redis : статусы и сессии
Media --> S3
Kafka --> WS : доставка событий
Kafka --> Notify
Kafka --> Search : индексирование
Notify --> Push
Auth ..> Monitor
Chat ..> Monitor
WS ..> Monitor
Message ..> Monitor
Kafka ..> Monitor
PG ..> Monitor
Redis ..> Monitor
@enduml
